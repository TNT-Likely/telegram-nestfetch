{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TG NestFetch",
  "version": "0.2.3",
  "identifier": "com.tntlikely.tgnestfetch",
  "build": {
    "beforeDevCommand": "npm run build:engine && npm --prefix ui run dev",
    "beforeBuildCommand": "npm run build:engine && npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TG NestFetch",
        "width": 960,
        "height": 680,
        "minWidth": 580,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNTlFM0E1QjNGNUFFM0YKUldRL3J2V3pwZU5aZnNFbWZWNEdNNC9JZ2tkR29LTzJpeVd3V3k2RWV5dEJWSkVDY0wvbTVML1oK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/TNT-Likely/telegram-nestfetch/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/nestfetch-engine", "binaries/tdl"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utilities",
    "shortDescription": "Desktop file downloader for Telegram",
    "longDescription": "An independent desktop application for browsing Telegram channel attachments, previewing videos, and downloading selected files.",
    "license": "MIT",
    "resources": { "../LICENSE": "LICENSE", "resources/tdl/": "third-party/tdl/" },
    "publisher": "TNT-Likely"
  }
}
