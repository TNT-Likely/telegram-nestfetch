+package dl
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"mime"
+	"strings"
+	"time"
+
+	"github.com/gotd/contrib/partio"
+	"github.com/gotd/contrib/tg_io"
+	"github.com/gotd/td/telegram"
+	"github.com/gotd/td/telegram/downloader"
+	"github.com/gotd/td/telegram/peers"
+	"github.com/gotd/td/tg"
+
+	"github.com/iyear/tdl/core/storage"
+	preview "github.com/iyear/tdl/internal/nestfetchpreview"
+)
+
+var (
+	errPreviewProtected   = errors.New("CHAT_FORWARDS_RESTRICTED")
+	errPreviewUnavailable = errors.New("NESTFETCH_PREVIEW_UNAVAILABLE")
+	errPreviewChanged     = errors.New("NESTFETCH_PREVIEW_MEDIA_CHANGED")
+)
+
+// NestFetchPreview exposes only the inspected video and holds no media on disk.
+func NestFetchPreview(ctx context.Context, client *telegram.Client, kvd storage.Storage,
+	channelID int64, messageID int, documentID, size int64, status io.Writer) error {
+	api := client.API()
+	manager := peers.Options{Storage: storage.NewPeers(kvd)}.Build(api)
+
+	lookup, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	channel, err := manager.ResolveChannelID(lookup, channelID)
+	if err != nil {
+		return err
+	}
+	if channel.Raw().Noforwards {
+		return errPreviewProtected
+	}
+	input := channel.Raw().AsInput()
+	refresh := func(ctx context.Context) (partio.ChunkSource, string, error) {
+		doc, contentType, err := lookupPreviewVideo(ctx, api, input, messageID, documentID, size)
+		if err != nil {
+			return nil, "", err
+		}
+		invoker, err := client.FileDC(ctx, doc.DCID)
+		if err != nil {
+			return nil, "", err
+		}
+		source := tg_io.NewDownloader(tg.NewClient(invoker)).ChunkSource(size, &tg.InputDocumentFileLocation{
+			ID: doc.ID, AccessHash: doc.AccessHash, FileReference: doc.FileReference,
+		})
+		return source, contentType, nil
+	}
+	source, contentType, err := refresh(lookup)
+	cancel()
+	if err != nil {
+		return err
+	}
+	read := func(ctx context.Context, offset int64, block []byte) (int, error) {
+		n, err := source.Chunk(ctx, offset, block)
+		if !downloader.IsFileReferenceError(err) {
+			return int(n), err
+		}
+		next, nextType, err := refresh(ctx)
+		if err != nil {
+			return 0, err
+		}
+		if nextType != contentType {
+			return 0, errPreviewChanged
+		}
+		source = next
+		n, err = source.Chunk(ctx, offset, block)
+		return int(n), err
+	}
+	return preview.Serve(ctx, size, contentType, read, func(address string) error {
+		_, err := fmt.Fprintln(status, "NESTFETCH_PREVIEW "+address)
+		return err
+	}, func(count int64, elapsed time.Duration) {
+		_, _ = fmt.Fprintf(status, "NESTFETCH_PREVIEW_READ %d %d\n", count, elapsed.Nanoseconds())
+	})
+}
+
+func lookupPreviewVideo(ctx context.Context, api *tg.Client, channel *tg.InputChannel, messageID int, documentID, size int64) (*tg.Document, string, error) {
+	reply, err := api.ChannelsGetMessages(ctx, &tg.ChannelsGetMessagesRequest{
+		Channel: channel, ID: []tg.InputMessageClass{&tg.InputMessageID{ID: messageID}},
+	})
+	if err != nil {
+		return nil, "", err
+	}
+	result, ok := reply.AsModified()
+	if !ok {
+		return nil, "", errPreviewChanged
+	}
+	for _, chat := range result.GetChats() {
+		if ch, ok := chat.(*tg.Channel); ok && ch.ID == channel.ChannelID && ch.Noforwards {
+			return nil, "", errPreviewProtected
+		}
+	}
+	for _, entry := range result.GetMessages() {
+		msg, ok := entry.(*tg.Message)
+		if !ok || msg.ID != messageID {
+			continue
+		}
+		if peer, ok := msg.PeerID.(*tg.PeerChannel); ok && peer.ChannelID == channel.ChannelID {
+			return previewDocument(msg, documentID, size)
+		}
+	}
+	return nil, "", errPreviewChanged
+}
+
+func previewDocument(msg *tg.Message, documentID, size int64) (*tg.Document, string, error) {
+	if _, timed := msg.GetTTLPeriod(); msg.Noforwards || timed || msg.TTLPeriod != 0 {
+		return nil, "", errPreviewProtected
+	}
+	attachment, ok := msg.Media.(*tg.MessageMediaDocument)
+	if !ok {
+		return nil, "", errPreviewUnavailable
+	}
+	if _, timed := attachment.GetTTLSeconds(); attachment.Spoiler || timed || attachment.TTLSeconds != 0 {
+		return nil, "", errPreviewProtected
+	}
+	doc, ok := attachment.Document.(*tg.Document)
+	if !ok || doc.ID != documentID || doc.Size != size {
+		return nil, "", errPreviewChanged
+	}
+	mimeType, _, _ := mime.ParseMediaType(doc.MimeType)
+	video := attachment.Video || attachment.Round || strings.HasPrefix(mimeType, "video/")
+	name := ""
+	for _, attr := range doc.Attributes {
+		switch value := attr.(type) {
+		case *tg.DocumentAttributeVideo:
+			video = true
+		case *tg.DocumentAttributeFilename:
+			name = value.FileName
+		}
+	}
+	if !video {
+		return nil, "", errPreviewUnavailable
+	}
+	return doc, preview.ContentType(mimeType, name), nil
+}
