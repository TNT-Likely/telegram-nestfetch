@@ -0,0 +1,45 @@
+package dl
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/gotd/td/tg"
+)
+
+func TestNestFetchPreviewOnlyAcceptsExpectedOrdinaryVideos(t *testing.T) {
+	for _, check := range []struct {
+		name   string
+		change func(*tg.Message, *tg.MessageMediaDocument, *tg.Document)
+		want   error
+	}{
+		{name: "video with generic Telegram MIME", change: func(*tg.Message, *tg.MessageMediaDocument, *tg.Document) {}},
+		{name: "different attachment", change: func(_ *tg.Message, _ *tg.MessageMediaDocument, d *tg.Document) { d.ID++ }, want: errPreviewChanged},
+		{name: "different size", change: func(_ *tg.Message, _ *tg.MessageMediaDocument, d *tg.Document) { d.Size++ }, want: errPreviewChanged},
+		{name: "forward protection", change: func(m *tg.Message, _ *tg.MessageMediaDocument, _ *tg.Document) { m.Noforwards = true }, want: errPreviewProtected},
+		{name: "message timer", change: func(m *tg.Message, _ *tg.MessageMediaDocument, _ *tg.Document) { m.SetTTLPeriod(0) }, want: errPreviewProtected},
+		{name: "attachment timer", change: func(_ *tg.Message, a *tg.MessageMediaDocument, _ *tg.Document) { a.SetTTLSeconds(0) }, want: errPreviewProtected},
+		{name: "spoiler", change: func(_ *tg.Message, a *tg.MessageMediaDocument, _ *tg.Document) { a.Spoiler = true }, want: errPreviewProtected},
+		{name: "nonvideo", change: func(_ *tg.Message, _ *tg.MessageMediaDocument, d *tg.Document) { d.Attributes = nil }, want: errPreviewUnavailable},
+	} {
+		t.Run(check.name, func(t *testing.T) {
+			d := &tg.Document{
+				ID: 3, Size: 100, MimeType: "application/octet-stream",
+				Attributes: []tg.DocumentAttributeClass{
+					&tg.DocumentAttributeFilename{FileName: "sample.webm"},
+					&tg.DocumentAttributeVideo{},
+				},
+			}
+			a := &tg.MessageMediaDocument{Document: d}
+			m := &tg.Message{Media: a}
+			check.change(m, a, d)
+			got, mime, err := previewDocument(m, 3, 100)
+			if !errors.Is(err, check.want) {
+				t.Fatalf("got %v, want %v", err, check.want)
+			}
+			if check.want == nil && (got != d || mime != "video/webm") {
+				t.Fatal("the pinned WebM video was not accepted")
+			}
+		})
+	}
+}
