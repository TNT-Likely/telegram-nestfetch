@@ -0,0 +1,43 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"strconv"
+
+	"github.com/gotd/td/telegram"
+	"github.com/spf13/cobra"
+
+	"github.com/iyear/tdl/app/dl"
+	"github.com/iyear/tdl/core/storage"
+)
+
+func newNestFetchPreview() *cobra.Command {
+	return &cobra.Command{
+		Use:    "nestfetch-preview CHANNEL MESSAGE DOCUMENT SIZE",
+		Hidden: true,
+		Args:   cobra.ExactArgs(4),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			channel, err1 := strconv.ParseInt(args[0], 10, 64)
+			message, err2 := strconv.ParseInt(args[1], 10, 32)
+			document, err3 := strconv.ParseInt(args[2], 10, 64)
+			size, err4 := strconv.ParseInt(args[3], 10, 64)
+			if err1 != nil || err2 != nil || err3 != nil || err4 != nil ||
+				channel <= 0 || message <= 0 || document == 0 || size <= 0 {
+				return fmt.Errorf("invalid preview request")
+			}
+
+			ctx, cancel := context.WithCancel(cmd.Context())
+			defer cancel()
+			// EOF ends the stream even if the desktop engine exits abruptly.
+			go func() {
+				_, _ = io.Copy(io.Discard, cmd.InOrStdin())
+				cancel()
+			}()
+			return tRun(ctx, func(ctx context.Context, client *telegram.Client, kvd storage.Storage) error {
+				return dl.NestFetchPreview(ctx, client, kvd, channel, int(message), document, size, cmd.OutOrStdout())
+			})
+		},
+	}
+}
