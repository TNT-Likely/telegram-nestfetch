diff --git a/core/util/tutil/nestfetch_saved.go b/core/util/tutil/nestfetch_saved.go
new file mode 100644
index 0000000..8875b94
--- /dev/null
+++ b/core/util/tutil/nestfetch_saved.go
@@ -0,0 +1,51 @@
+package tutil
+
+import (
+	"context"
+	"errors"
+
+	"github.com/gotd/td/telegram/peers"
+	"github.com/gotd/td/tg"
+)
+
+var ErrNestFetchSavedAccountMismatch = errors.New("NESTFETCH_SAVED_ACCOUNT_MISMATCH")
+
+// NestFetchSavedPeer resolves the current session's personal Saved Messages.
+// An expected owner of zero is used only when listing them.
+func NestFetchSavedPeer(ctx context.Context, manager *peers.Manager, owner int64) (peers.User, error) {
+	self, err := manager.Self(ctx)
+	if err != nil {
+		return peers.User{}, err
+	}
+	if self.ID() <= 0 || !self.Self() {
+		return peers.User{}, errors.New("PEER_ID_INVALID")
+	}
+	if owner != 0 && self.ID() != owner {
+		return peers.User{}, ErrNestFetchSavedAccountMismatch
+	}
+	return self, nil
+}
+
+func NestFetchSavedMessageMatches(msg *tg.Message, owner int64) bool {
+	if msg == nil {
+		return false
+	}
+	peer, ok := msg.PeerID.(*tg.PeerUser)
+	return ok && peer.UserID == owner
+}
+
+func NestFetchSavedMediaProtected(msg *tg.Message) bool {
+	if _, timed := msg.GetTTLPeriod(); msg.Noforwards || timed || msg.TTLPeriod != 0 {
+		return true
+	}
+	switch media := msg.Media.(type) {
+	case *tg.MessageMediaDocument:
+		_, timed := media.GetTTLSeconds()
+		return timed || media.TTLSeconds != 0
+	case *tg.MessageMediaPhoto:
+		_, timed := media.GetTTLSeconds()
+		return timed || media.TTLSeconds != 0
+	default:
+		return false
+	}
+}
diff --git a/core/util/tutil/nestfetch_saved_test.go b/core/util/tutil/nestfetch_saved_test.go
new file mode 100644
index 0000000..c410929
--- /dev/null
+++ b/core/util/tutil/nestfetch_saved_test.go
@@ -0,0 +1,64 @@
+package tutil
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/gotd/td/telegram/peers"
+	"github.com/gotd/td/tg"
+	"github.com/gotd/td/tgmock"
+)
+
+func TestNestFetchSavedPeerPinsTheAuthenticatedAccount(t *testing.T) {
+	const owner = 456789
+	for _, tc := range []struct {
+		name string
+		want int64
+		err  error
+	}{
+		{name: "list", want: 0},
+		{name: "matching owner", want: owner},
+		{name: "account switched", want: owner + 1, err: ErrNestFetchSavedAccountMismatch},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := tgmock.New(t)
+			mock.ExpectCall(&tg.UsersGetUsersRequest{ID: []tg.InputUserClass{&tg.InputUserSelf{}}}).
+				ThenResult(&tg.UserClassVector{Elems: []tg.UserClass{&tg.User{ID: owner, Self: true}}})
+			manager := peers.Options{}.Build(tg.NewClient(mock))
+			user, err := NestFetchSavedPeer(context.Background(), manager, tc.want)
+			if !errors.Is(err, tc.err) {
+				t.Fatalf("owner resolution: %v, want %v", err, tc.err)
+			}
+			if err == nil {
+				if _, ok := user.InputPeer().(*tg.InputPeerSelf); !ok || user.ID() != owner {
+					t.Fatal("ownership check did not return the authenticated self peer")
+				}
+			}
+		})
+	}
+}
+
+func TestNestFetchSavedMessageRejectsOtherPeerTypesAndProtection(t *testing.T) {
+	const owner int64 = 456789
+	msg := &tg.Message{PeerID: &tg.PeerChannel{ChannelID: owner}}
+	if NestFetchSavedMessageMatches(msg, owner) {
+		t.Fatal("accepted a channel with the same numeric ID")
+	}
+	msg.PeerID = &tg.PeerUser{UserID: owner}
+	if !NestFetchSavedMessageMatches(msg, owner) {
+		t.Fatal("rejected the authenticated user's message")
+	}
+	document := &tg.MessageMediaDocument{}
+	document.SetTTLSeconds(0)
+	msg.Media = document
+	if !NestFetchSavedMediaProtected(msg) {
+		t.Fatal("accepted document with a TTL flag")
+	}
+	photo := &tg.MessageMediaPhoto{}
+	photo.SetTTLSeconds(0)
+	msg.Media = photo
+	if !NestFetchSavedMediaProtected(msg) {
+		t.Fatal("accepted photo with a TTL flag")
+	}
+}
