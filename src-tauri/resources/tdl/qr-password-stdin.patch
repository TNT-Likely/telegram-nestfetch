+func qrPassword() (string, error) {
+	const prompt = "Enter 2FA Password:"
+	if os.Getenv("TDL_NESTFETCH_PASSWORD_STDIN") == "1" {
+		if _, err := fmt.Fprintln(os.Stdout, prompt); err != nil {
+			return "", err
+		}
+		line, err := bufio.NewReaderSize(os.Stdin, 4097).ReadSlice('\n')
+		defer clear(line)
+		if err != nil {
+			return "", err
+		}
+		if len(line) == 1 {
+			return "", errors.New("missing 2fa password")
+		}
+		return string(line[:len(line)-1]), nil
+	}
+
+	var password string
+	err := survey.AskOne(&survey.Password{Message: prompt}, &password, survey.WithValidator(survey.Required))
+	return password, err
+}
